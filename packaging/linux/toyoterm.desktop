[Desktop Entry]
Type=Application
Name=toyoterm
Comment=Programmable terminal emulator
Comment[ja]=プログラマブルターミナルエミュレーター
Exec="@TOYOTERM_BINARY@"
Icon=toyoterm
Terminal=false
Categories=System;TerminalEmulator;
Keywords=terminal;shell;console;
StartupNotify=true
X-TerminalArgExec=-e
X-TerminalArgTitle=--title=
X-TerminalArgAppId=--app-id=
X-TerminalArgDir=--working-directory=
