;; Complete example: every binding is explicitly configured.
(config-set! 'font.family "monospace")
(config-set! 'font.fallback '("Noto Sans Mono CJK JP" "Noto Color Emoji"))
(config-set! 'font.size 14)
(config-set! 'font.weight 400)
(config-set! 'window.image.opacity 0.25)
(leader! "CTRL+B" 1000)
(bind-action! "F11" 'toggle-fullscreen)
(bind-action! "CTRL+TAB" 'next-tab)
(bind-action! "CTRL+SHIFT+TAB" 'previous-tab)
(bind-action! "CTRL+ALT+LEFT" 'previous-workspace)
(bind-action! "CTRL+ALT+RIGHT" 'next-workspace)
(bind-action! "LEADER+[" 'previous-prompt)
(bind-action! "LEADER+]" 'next-prompt)
(bind-action! "LEADER+," 'previous-mark)
(bind-action! "LEADER+." 'next-mark)
(bind-action! "LEADER+P" 'select-previous-command-output)
(bind-action! "LEADER+N" 'select-next-command-output)
(bind-action! "LEADER+O" 'select-last-command-output)
(bind-action! "LEADER+V" 'toggle-visual-mode)
(bind-action! "SPACE" 'select-visual-selection)
(bind-action! "ESCAPE" 'end-visual-selection)
(bind-action! "H" 'move-visual-selection 'left)
(bind-action! "J" 'move-visual-selection 'down)
(bind-action! "K" 'move-visual-selection 'up)
(bind-action! "L" 'move-visual-selection 'right)
(bind-action! "W" 'move-visual-selection 'word-forward)
(bind-action! "B" 'move-visual-selection 'word-backward)
(bind-action! "LEFT" 'move-visual-selection 'left)
(bind-action! "RIGHT" 'move-visual-selection 'right)
(bind-action! "UP" 'move-visual-selection 'up)
(bind-action! "DOWN" 'move-visual-selection 'down)
(bind-action! "0" 'move-visual-selection 'line-start)
(bind-action! "$" 'move-visual-selection 'line-end)
(bind-action! "Y" 'yank-selection)
(bind-action! "LEADER+S" 'split 'right)
(if (equal? (toyoterm-platform) 'macos)
  (begin
(bind-action! "CTRL+SUPER+F" 'toggle-fullscreen)
(bind-action! (string-append (primary-modifier) "+R") 'reload-config)
(bind-action! (string-append (primary-modifier) "+SHIFT+F") 'search)
(bind-action! (string-append (primary-modifier) "+T") 'new-tab)
(bind-action! (string-append (primary-modifier) "+N") 'new-workspace)
(bind-action! (string-append (primary-modifier) "+W") 'close-tab)
(bind-action! (string-append (primary-modifier) "+SHIFT+W") 'close-pane)
(bind-action! (string-append (primary-modifier) "+D") 'split 'right)
(bind-action! (string-append (primary-modifier) "+SHIFT+D") 'split 'down)
(bind-action! (string-append (primary-modifier) "+ALT+LEFT") 'activate-pane 'left)
(bind-action! (string-append (primary-modifier) "+ALT+RIGHT") 'activate-pane 'right)
(bind-action! (string-append (primary-modifier) "+ALT+UP") 'activate-pane 'up)
(bind-action! (string-append (primary-modifier) "+ALT+DOWN") 'activate-pane 'down)
(bind-action! (string-append (primary-modifier) "+C") 'copy-selection)
(bind-action! (string-append (primary-modifier) "+V") 'paste-clipboard))
  (begin
(bind-action! "CTRL+SHIFT+R" 'reload-config)
(bind-action! "CTRL+SHIFT+F" 'search)
(bind-action! "CTRL+SHIFT+T" 'new-tab)
(bind-action! "CTRL+SHIFT+N" 'new-workspace)
(bind-action! "CTRL+SHIFT+W" 'close-tab)
(bind-action! "CTRL+SHIFT+\\" 'split 'right)
(bind-action! "CTRL+SHIFT+|" 'split 'right)
(bind-action! "CTRL+SHIFT+-" 'split 'down)
(bind-action! "CTRL+SHIFT+_" 'split 'down)
(bind-action! "CTRL+SHIFT+Q" 'close-pane)
(bind-action! "CTRL+SHIFT+LEFT" 'activate-pane 'left)
(bind-action! "CTRL+SHIFT+RIGHT" 'activate-pane 'right)
(bind-action! "CTRL+SHIFT+UP" 'activate-pane 'up)
(bind-action! "CTRL+SHIFT+DOWN" 'activate-pane 'down)
(bind-action! "ALT+F10" 'toggle-maximize)
(bind-action! "ALT+F9" 'minimize-window)
(bind-action! "CTRL+SHIFT+C" 'copy-selection)
(bind-action! "CTRL+SHIFT+V" 'paste-clipboard)))

(on! 'command-started (lambda (event) (pane-badge-set! (context-ref event 'pane) #f)))
(on! 'command-finished (lambda (event)
  (define status (context-ref event 'exit-status))
  (pane-badge-set! (context-ref event 'pane)
    (if (or (not status) (= status 0)) #f (string-append "exit " (number->string status))))))
(command! 'login_shell_pane (lambda (ctx)
  (define windows? (equal? (toyoterm-platform) 'windows))
  (define env (toyoterm-env))
  (split! (context-ref ctx 'pane) 'right
    (hash 'program (if windows? "powershell.exe" (if (hash-contains? env "SHELL") (hash-ref env "SHELL") "/bin/sh"))
          'args (if windows? '("-NoExit") '("-l"))
          'cwd (handle-ref (context-ref ctx 'pane) 'cwd)
          'env (hash "TOYOTERM_LAYOUT" "login")))))
(command! 'monitor_window (lambda (ctx) (new-window! (context-ref ctx 'workspace) (hash 'program "btop" 'cwd (handle-ref (context-ref ctx 'pane) 'cwd)))))
(command! 'backend_workspace (lambda (ctx) (open-workspace! 'backend)))
(command! 'presentation_mode (lambda (ctx) (context-action! ctx 'toggle-fullscreen)))
(command! 'copy_screen (lambda (ctx) (clipboard-write! (handle-ref (context-ref ctx 'pane) 'screen-text))))
(command! 'previous_error (lambda (ctx) (pane-search! (context-ref ctx 'pane) "error" 'previous)))
