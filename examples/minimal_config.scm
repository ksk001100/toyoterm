(config-set! 'font.family "monospace")
(config-set! 'font.size 14)
(leader! "CTRL+B" 1000)
(bind-action! "CTRL+SHIFT+T" 'new-tab)
(bind-action! "CTRL+SHIFT+E" 'split 'right)
(bind-action! "CTRL+SHIFT+O" 'activate-pane 'right)
(bind-action! "CTRL+SHIFT+R" 'reload-config)
(bind-command! "LEADER+G" 'git_status)
(bind! "CTRL+SHIFT+H" (lambda (ctx) (pane-send-text! (context-ref ctx 'pane) "echo hello from toyoterm\n")))
(command! 'git_status (lambda (ctx) (pane-send-text! (context-ref ctx 'pane) "git status\n")))
(bar! 'bottom 'left " | " (list (widget (lambda (ctx) (handle-ref (context-ref ctx 'workspace) 'name)) 1.0)))
(bar! 'bottom 'right " | " (list (widget (lambda (ctx) (or (handle-ref (context-ref ctx 'pane) 'cwd) "")) 1.0)))
