;; Stable non-networked fixture for GUI and headless soaks.
(config-set! 'font.family "monospace")
(config-set! 'font.fallback '("Noto Color Emoji"))
(config-set! 'font.size 14)
(config-set! 'colors.background "#112233")
(config-set! 'colors.foreground "#ddeeff")
(config-set! 'scrollback_lines 1000)
(config-set! 'default_shell (if (equal? (toyoterm-platform) 'windows) "cmd.exe" "/bin/sh"))
(config-set! 'window.image.path "../crates/toyoterm-script/tests/fixtures/background.png")
(config-set! 'window.image.opacity 0.2)
(bar! 'bottom 'left " | " (list (widget (lambda (ctx) (handle-ref (context-ref ctx 'workspace) 'name)) 1.0)))
(define soak-commands 0)
(define soak-events 0)
(command! 'soak_command (lambda (ctx) (set! soak-commands (+ soak-commands 1))))
(on! 'bell (lambda (event) (set! soak-events (+ soak-events 1))))
